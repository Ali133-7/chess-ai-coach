# Optional public Chess.com username for legacy single-player services only.
CHESS_USERNAME=
# Required only when enabling the legacy profile. Generate a random 32+ character value.
CHESS_API_KEY=
STUDIO_COOKIE_SECURE=false
STUDIO_BASE_URL=
STUDIO_ENGINE_THREADS=1
STUDIO_ENGINE_HASH_MB=96
STUDIO_SYNC_SECONDS=900
TEACHER_PROVIDERS_FILE=/studio-data/teacher-providers.json
DEEP_SECONDS_PER_POSITION=120
DEEP_MULTIPV=3
DEEP_THREADS=1
DEEP_HASH_MB=128
ARCHIVE_REFRESH_HOURS=6
POLL_SECONDS=180
MAX_NEW_PER_POLL=3
ANALYSIS_TIME_SECONDS=0.12
TRAINING_ENGINE_SECONDS=4
# Optional verified HTTPS email delivery; password is a private mounted file.
STUDIO_SMTP_HOST=
STUDIO_SMTP_PORT=587
STUDIO_SMTP_MODE=starttls
STUDIO_SMTP_FROM=
STUDIO_SMTP_USERNAME=
STUDIO_SMTP_PASSWORD_FILE=/studio-data/smtp-password
# Enable only after every administrator has enrolled and saved recovery codes.
STUDIO_REQUIRE_ADMIN_MFA=false
STUDIO_HTTP_P95_ALERT_MS=1000
STUDIO_QUEUE_ALERT_SECONDS=900
